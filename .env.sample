NODE_ENV='development'
BACKEND_URL=''

# Optional: send one API group to a different backend (used while the backend
# moves to a new service one group at a time). The groups are auth, me, admin,
# forms, analytics and reports; a group without its own variable uses
# BACKEND_URL. The list of paths per group is
# src/core/constants/backendEndpoints.ts.
# BACKEND_URL_FORMS=''

# The backend keeps no cookies: this app stores the access token in the cookie
# named by TOKEN_NAME and the refresh token in REFRESH_TOKEN_NAME.
# REFRESH_TOKEN_NAME='refresh_token'
TOKEN_NAME='token'

# Error tracking (X-2d). NEXT_PUBLIC_ prefix is required for the client
# bundle to see it -- a Sentry DSN is a public identifier, not a secret,
# so that's safe. Leave blank to disable the SDK entirely (local dev/CI).
NEXT_PUBLIC_SENTRY_DSN=''
NEXT_PUBLIC_SENTRY_ENVIRONMENT='local'
{
  "name": "researchers-web-app",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "qc": "echo \"### (1/3) TypeScript Check:\" && pnpm run qc:type && echo \"###(2/3) ESLint Check:\" && pnpm run qc:lint && echo \"###(3/3) Prettier Check:\" && pnpm run qc:format",
    "qc:type": "tsc --noEmit && echo TypeScript Check: Passed",
    "qc:lint": "eslint src --cache && echo ESLint Check: Passed",
    "qc:format": "prettier --check \"src/**/*.{ts,tsx}\" && echo Prettier Check: Passed",
    "fix:lint": "eslint src --cache --fix",
    "fix:format": "prettier --write \"src/**/*.{ts,tsx}\""
  },
  "dependencies": {
    "@emotion/cache": "^11.14.0",
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@mui/icons-material": "^7.3.7",
    "@mui/material": "^7.3.7",
    "@mui/material-nextjs": "^7.3.7",
    "@turf/bbox": "^7.3.4",
    "@turf/center": "^7.3.4",
    "@types/geojson": "^7946.0.16",
    "chart.js": "^4.5.1",
    "client-only": "^0.0.1",
    "geojson": "^0.5.0",
    "maplibre-gl": "^5.20.2",
    "next": "16.1.6",
    "ol": "^10.8.0",
    "react": "19.2.3",
    "react-chartjs-2": "^5.3.1",
    "react-dom": "19.2.3",
